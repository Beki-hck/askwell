# Askwell runs with none of these set: it then serves the built-in demo from memory.

# Database (Supabase). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a model that writes answers for every visitor. Without it, visitors
# get search-only answers unless they paste their own key.
# Provider is one of: anthropic, openai, gemini, groq, ollama
ASKWELL_LLM_PROVIDER=
ASKWELL_LLM_API_KEY=
ASKWELL_LLM_MODEL=

# Optional: set to 1 to let people edit the demo business on a hosted copy.
ASKWELL_DEMO_WRITABLE=
